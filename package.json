{
  "name": "use-axios-loader",
  "version": "1.4.3",
  "description": "Tiny React hook that turns axios request activity into a single loading boolean",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react",
    "hooks",
    "react-hooks",
    "axios",
    "loader",
    "axios-loader"
  ],
  "author": "scorpioliv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/olivier1208/use-axios-loader.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && rollup -c",
    "start": "rollup -c -w",
    "prepare": "npm run build",
    "size": "npm run build && node -e \"const fs=require('fs');const zlib=require('zlib');const source=fs.readFileSync('dist/index.es.js');console.log(zlib.gzipSync(source,{level:9}).length+' B gzip');\"",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "identity-obj-proxy"
    }
  },
  "peerDependencies": {
    "axios": ">=0.19",
    "react": ">=16.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.28.6",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "axios": "^1.13.6",
    "babel-jest": "^30.2.0",
    "eslint": "^10.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rollup": "^4.59.0"
  },
  "resolutions": {
    "test-exclude": "8.0.0"
  }
}
